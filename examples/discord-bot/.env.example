DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
AGENTO_MODEL=gpt-4o-mini
# Real API running on your own computer. Override for staging/production.
AGENTO_API_BASE_URL=http://localhost:3000
AGENTO_ALLOW_INSECURE_HTTP=true
# Token from YOUR API login. Leave blank to exercise upstream 401 responses.
AGENTO_USER_ACCESS_TOKEN=
# Your Discord user ID; required only when sharing a token through the variable above.
DISCORD_TEST_USER_ID=
AGENTO_DEBUG=false
